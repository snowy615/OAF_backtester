# Claude (idea -> signal, data-mapping assistant). Alternatively run `ant auth login`.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
# OAF_CLAUDE_MODEL=claude-opus-5

# IBKR (TWS / IB Gateway must be running with API access enabled)
# Paper ports: TWS 7497, Gateway 4002.  Live ports: TWS 7496, Gateway 4001.
OAF_IBKR_HOST=127.0.0.1
OAF_IBKR_PORT=7497
OAF_IBKR_CLIENT_ID=17

# Year 2 only. Live trading stays locked unless this is set to exactly the value below
# AND the deploy command is run with --live.
# OAF_ENABLE_LIVE_TRADING=YES-I-UNDERSTAND
